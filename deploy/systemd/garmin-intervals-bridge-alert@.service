# Mails the last journal lines of a failed bridge unit to the owner, at most once every
# six hours. Wired in via OnFailure= in the service units. Addresses in alert.env.
# (Shell logic lives in a script: systemd expands %s inside ExecStart, which turned a
#  printf format into the login shell and the To: header into /bin/bash.)
[Unit]
Description=Alert mail for failed %i

[Service]
Type=oneshot
EnvironmentFile=/etc/garmin-intervals-bridge/alert.env
ExecStart=/usr/local/sbin/gib-alert %i
