# garmin-intervals-bridge: archive what is not a time series (profile, settings, devices,
# zones, gear, personal records, badges, workouts, training plans) once a month, so the
# local mirror stays complete. About 30 Garmin requests.
[Unit]
OnFailure=garmin-intervals-bridge-alert@%n.service
Description=Garmin -> Intervals.icu bridge: monthly account snapshot
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=gib
Group=gib
UMask=0077
WorkingDirectory=/var/lib/garmin-intervals-bridge
EnvironmentFile=/etc/garmin-intervals-bridge/env
Environment=BRIDGE_DATA_DIR=/var/lib/garmin-intervals-bridge
Environment=GARMIN_TOKEN_DIR=/var/lib/garmin-intervals-bridge/tokens
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=BRIDGE_TIMEZONE=Europe/Vienna
ExecStart=/opt/garmin-intervals-bridge/venv/bin/garmin-intervals-bridge snapshot-account
# Hardening: the process needs the network, its data directory and nothing else.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/garmin-intervals-bridge
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# system-call set a service needs, 512 MB ceiling (a FIT file is a few MB; decoding it tens).
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
PrivateDevices=yes
RestrictRealtime=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
ProtectProc=invisible
MemoryMax=512M
TimeoutStartSec=5min
