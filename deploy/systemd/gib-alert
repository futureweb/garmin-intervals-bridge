#!/bin/bash
# Mail the status and last journal lines of a failed garmin-intervals-bridge unit.
# Throttled: at most one mail per 6 hours (a Garmin outage must not mail every minute).
# Usage: gib-alert <unit name>   (wired in via OnFailure=garmin-intervals-bridge-alert@%n.service)
set -u
unit="$1"
: "${ALERT_TO:?ALERT_TO missing (see /etc/garmin-intervals-bridge/alert.env)}"
: "${ALERT_FROM:=garmin-intervals-bridge@$(hostname -f)}"
stamp=/run/garmin-intervals-bridge-alert.stamp
if [ -f "$stamp" ] && [ $(( $(date +%s) - $(stat -c %Y "$stamp") )) -lt 21600 ]; then
  exit 0
fi
touch "$stamp"
{
  printf 'To: %s\nFrom: %s\nSubject: [garmin-intervals-bridge] %s failed on %s\nContent-Type: text/plain; charset=UTF-8\n\n' \
    "$ALERT_TO" "$ALERT_FROM" "$unit" "$(hostname)"
  systemctl status "$unit" --no-pager -n 0 2>&1 | head -12
  echo
  echo "--- last 40 journal lines ---"
  journalctl -u "$unit" -n 40 -o cat --no-pager
} | /usr/sbin/sendmail -t
