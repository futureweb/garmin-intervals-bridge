# garmin-intervals-bridge: Garmin Connect original FIT -> Intervals.icu enrichment.
# Runs as the unprivileged service user `gib`; code is read-only for it, state lives in
# /var/lib/garmin-intervals-bridge. Secrets come from /etc/garmin-intervals-bridge/env
# (root:gib 0640). DRY RUN: nothing is written to Intervals until --apply is added below,
# which happens only on the owner's explicit decision.
[Unit]
OnFailure=garmin-intervals-bridge-alert@%n.service
Description=Garmin -> Intervals.icu bridge: daily health probe
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=gib
Group=gib
UMask=0077
WorkingDirectory=/var/lib/garmin-intervals-bridge
EnvironmentFile=/etc/garmin-intervals-bridge/env
Environment=BRIDGE_DATA_DIR=/var/lib/garmin-intervals-bridge
Environment=GARMIN_TOKEN_DIR=/var/lib/garmin-intervals-bridge/tokens
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=BRIDGE_TIMEZONE=Europe/Vienna
ExecStart=/opt/garmin-intervals-bridge/venv/bin/garmin-intervals-bridge health
# Hardening: the process needs the network, its data directory and nothing else.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/garmin-intervals-bridge
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# Hardening, second layer: no capabilities, no new namespaces or device access, only the
# system-call set a service needs, 512 MB ceiling (a FIT file is a few MB; decoding it tens).
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
PrivateDevices=yes
RestrictRealtime=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
ProtectProc=invisible
MemoryMax=512M
TimeoutStartSec=5min
