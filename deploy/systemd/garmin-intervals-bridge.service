# garmin-intervals-bridge: Garmin Connect original FIT -> Intervals.icu enrichment.
#
# Runs as an unprivileged service user. The code may live anywhere readable;
# the virtualenv must live outside any web document root (on SELinux hosts
# systemd cannot execute files labelled as web content), /opt is the default.
# State lives in /var/lib/garmin-intervals-bridge, secrets in
# /etc/garmin-intervals-bridge/env (root:gib 0640, see deploy/README.md).
#
# DRY RUN by default: nothing is written to Intervals until you add --apply to
# ExecStart. Do that only after reviewing a few dry-run journals.
[Unit]
OnFailure=garmin-intervals-bridge-alert@%n.service
Description=Garmin -> Intervals.icu bridge (activities, enrich mode)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=gib
Group=gib
UMask=0077
WorkingDirectory=/var/lib/garmin-intervals-bridge
EnvironmentFile=/etc/garmin-intervals-bridge/env
Environment=BRIDGE_DATA_DIR=/var/lib/garmin-intervals-bridge
Environment=GARMIN_TOKEN_DIR=/var/lib/garmin-intervals-bridge/tokens
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=BRIDGE_TIMEZONE=Europe/Vienna
ExecStart=/opt/garmin-intervals-bridge/venv/bin/garmin-intervals-bridge sync --scope all --mode enrich --activity-days 4
# Hardening: the process needs the network, its data directory and nothing else.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/garmin-intervals-bridge
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# Hardening, second layer: no capabilities, no new namespaces or device access, only the
# system-call set a service needs, 512 MB ceiling (a FIT file is a few MB; decoding it tens).
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
PrivateDevices=yes
RestrictRealtime=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
ProtectProc=invisible
MemoryMax=512M
TimeoutStartSec=20min
